<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>UnicornOverloardEditor</AssemblyName>
    <Product>UnicornOverloardEditor</Product>
    <Version>0.14.0</Version>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/AppIcon.png" />
    <Content Include="Assets/AppIcon.icns" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../web/info/**/*" Link="info/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../web/mods/**/*" Link="mods/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../web/locales/*.json" Link="locales/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../docs/第三方MOD来源.md" Link="THIRD_PARTY_MODS.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
